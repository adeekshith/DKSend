# Runs Rust unit/integration tests and JS unit tests.
# Build and run:
#   docker build -f Dockerfile.test -t dksend-unit-tests .
#   docker run --rm dksend-unit-tests
FROM rust:1.97-alpine

RUN apk add --no-cache musl-dev build-base nodejs

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY static ./static
COPY templates ./templates
COPY migrations ./migrations
COPY tests/cli.rs ./tests/cli.rs
COPY tests/unit ./tests/unit

RUN cargo test
RUN node --test tests/unit/app.test.mjs
